<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1300.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.JanelaPrincipalController">

    <left>
        <VBox prefWidth="280.0" spacing="10.0" style="-fx-background-color: #E0E0E0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Novo Passatempo">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>

                <Label text="Nome:" />
                <TextField fx:id="inputNome" promptText="Ex: Futebol..." />

                <Label text="Tipo:" />
                <ComboBox fx:id="comboTipo" prefWidth="250.0" />

                <Separator prefWidth="200.0" />

                <Label fx:id="lblCampo1" text="Campo 1" />
                <TextField fx:id="txtCampo1" />

                <Label fx:id="lblCampo2" text="Campo 2" />
                <TextField fx:id="txtCampo2" />

                <Label fx:id="lblCampo3" text="Campo 3" />
                <TextField fx:id="txtCampo3" />

                <Label fx:id="lblCampo4" text="Campo 4" />
                <TextField fx:id="txtCampo4" />

                <Label fx:id="lblCampo5" text="Campo 5" />
                <TextField fx:id="txtCampo5" />

                <Button mnemonicParsing="false" onAction="#acaoAdicionar" prefWidth="250.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="ADICIONAR">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 5;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Label text="Registar Sessão (Horas):">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TextField fx:id="inputHoras" prefWidth="80.0" promptText="Horas" />
                        <Button mnemonicParsing="false" onAction="#acaoRegistarSessao" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Registar Tempo" />
                    </children>
                </HBox>

                <TableView fx:id="tabelaPassatempos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="150.0" text="Nome" />
                        <TableColumn fx:id="colTipo" prefWidth="90.0" text="Tipo" />
                        <TableColumn fx:id="colPrincipal" prefWidth="160.0" text="Info Principal" />
                        <TableColumn fx:id="colSecundaria" prefWidth="120.0" text="Detalhes" />
                        <TableColumn fx:id="colDetalhe1" prefWidth="120.0" text="Extra 1" />
                        <TableColumn fx:id="colDetalhe2" prefWidth="80.0" text="Extra 2" />
                        <TableColumn fx:id="colAvaliacao" prefWidth="70.0" text="Nota" />
                        <TableColumn fx:id="colTempoTotal" prefWidth="100.0" text="Tempo Total" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <Button mnemonicParsing="false" onAction="#acaoApagar" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Apagar Selecionado" />
            </children>
        </VBox>
    </center>
</BorderPane>