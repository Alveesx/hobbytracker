<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.JanelaPrincipalController">

    <left>
        <VBox spacing="10.0" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label text="Adicionar Novo Hobby">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <Label text="Nome do Passatempo:" />
                <TextField fx:id="inputNome" promptText="Ex: Minecraft, Harry Potter..." />

                <Label text="Tipo de Hobby:" />
                <ComboBox fx:id="comboTipo" prefWidth="200.0" />

                <Separator prefWidth="200.0" />

                <Label fx:id="lblCampo1" text="Campo 1" />
                <TextField fx:id="txtCampo1" />

                <Label fx:id="lblCampo2" text="Campo 2" />
                <TextField fx:id="txtCampo2" />

                <Label fx:id="lblCampo3" text="Campo 3" />
                <TextField fx:id="txtCampo3" />

                <Label fx:id="lblCampo4" text="Campo 4" />
                <TextField fx:id="txtCampo4" />

                <Label fx:id="lblCampo5" text="Campo 5" />
                <TextField fx:id="txtCampo5" />

                <Separator prefWidth="200.0" />

                <Button mnemonicParsing="false" onAction="#acaoAdicionar" prefWidth="200.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Adicionar Hobby">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>

                <Separator prefHeight="20.0" prefWidth="200.0" />

                <Label text="Registar Tempo (Minutos):" />
                <HBox spacing="5.0">
                    <children>
                        <TextField fx:id="inputMinutos" prefWidth="80.0" promptText="Min" />
                        <Button mnemonicParsing="false" onAction="#acaoRegistarSessao" text="Registar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>

    <center>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <TableView fx:id="tabelaPassatempos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNome" prefWidth="250.0" text="Nome do Passatempo" />
                        <TableColumn fx:id="colProgresso" prefWidth="150.0" text="Progresso (%)" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-background-color: #e0e0e0;">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#acaoApagar" style="-fx-background-color: #F44336; -fx-text-fill: white;" text="Apagar Selecionado" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>